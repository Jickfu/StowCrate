<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StowCrate.App.ViewModels"
        xmlns:services="using:StowCrate.App.Services"
        x:Class="StowCrate.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="归匣 · 备份工作台" Width="1020" Height="840" MinWidth="720" MinHeight="580">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="18" MaxWidth="1100">
            <StackPanel Spacing="6">
                <TextBlock Text="归匣  /  STOWCRATE" FontSize="13" Opacity="0.65" />
                <TextBlock Text="备份工作台" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="使用个人配置开始，或通过高级入口打开已有配置库。" TextWrapping="Wrap" />
                <Button Content="开始使用" Command="{Binding StartCommand}" />
                <TextBlock Text="配置由软件保存在当前用户的应用数据目录；备份源和归档输出位置独立选择。" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                <TextBlock Text="{Binding Status}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap" />
            </StackPanel>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="新建备份方案" FontSize="18" FontWeight="SemiBold" />
                    <TextBox Text="{Binding PlanName}" PlaceholderText="方案名称，例如：工作资料" AutomationProperties.Name="新方案名称" />
                    <TextBox Text="{Binding SourceName}" PlaceholderText="第一个备份源的名称，例如：项目" AutomationProperties.Name="备份源名称" />
                    <TextBox Text="{Binding SourceOutputPath}" PlaceholderText="输出相对目录（必填），例如：projects" AutomationProperties.Name="源输出相对目录" />
                    <TextBlock Text="初始设置：7z · 标准压缩 · 不加密 · 历史关闭 · 手动执行 · 保留链接对象 · Standard 变更检测。没有预设排除规则。" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="此步骤保存方案声明；物理目录和归档箱尚未配置，不能执行备份。相对目录不填写盘符或绝对路径。" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                    <Button Content="保存新方案" Command="{Binding CreatePlanCommand}" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="高级：打开已有配置库" FontSize="18" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding DatabasePath}" PlaceholderText="已有 config.db 的完整路径" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="配置库路径" />
                        <Button Grid.Column="1" Content="选择文件…" Click="ChooseDatabase" IsEnabled="{Binding CanEdit}" />
                        <Button Grid.Column="2" Content="打开" Command="{Binding OpenCommand}" />
                    </Grid>
                    <TextBlock Text="打开已有库时可能升级其数据结构。不会新建配置库或自动恢复迁移。" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="选择备份方案" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" HorizontalAlignment="Stretch" PlaceholderText="打开配置库后选择方案" AutomationProperties.Name="备份方案">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:RelocationPlanChoice">
                                <StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Id.Value}" FontSize="11" Opacity="0.6" /></StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel Spacing="12" DataContext="{Binding Bindings}" x:DataType="vm:DirectoryBindingsViewModel">
                    <TextBlock Text="本机目录绑定" FontSize="18" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Sources}" IsEnabled="{Binding CanEdit}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceDirectoryRow">
                                <StackPanel Spacing="6" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding Path}" PlaceholderText="备份源完整目录路径" />
                                        <Button Grid.Column="1" Content="选择源目录…" Click="ChooseBindingDirectory" Tag="source" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Current 输出根（必填）" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsEnabled="{Binding CanEdit}">
                        <TextBox Text="{Binding CurrentRoot}" PlaceholderText="已存在的输出目录" />
                        <Button Grid.Column="1" Content="选择 Current…" Click="ChooseBindingDirectory" Tag="current" />
                    </Grid>
                    <TextBlock Text="History 根：启用历史的归档箱需要此目录；当前不需要时保留已有绑定。" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsEnabled="{Binding CanEdit}">
                        <TextBox Text="{Binding HistoryRoot}" IsEnabled="{Binding HistoryRequired}" PlaceholderText="当前未要求历史目录" />
                        <Button Grid.Column="1" Content="选择 History…" Click="ChooseBindingDirectory" Tag="history" IsEnabled="{Binding HistoryRequired}" />
                    </Grid>
                    <TextBlock Text="要求目标根已存在，缺失时提示用户创建" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存目录绑定" Command="{Binding SaveCommand}" />
                        <Button Content="重新读取目录" Command="{Binding ReloadCommand}" />
                        <Button Content="取消目录操作" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="源目录树" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel DataContext="{Binding SourceTree}" x:DataType="vm:SourceTreeViewModel" Spacing="10">
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Stretch" PlaceholderText="请先保存源目录绑定" AutomationProperties.Name="浏览备份源">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SourceTreeChoice"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="读取源目录树" Command="{Binding ReadCommand}" />
                        <Button Content="取消读取" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                        <SelectableTextBlock Text="{Binding RootPath}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        <TreeView ItemsSource="{Binding Roots}" MaxHeight="360" AutomationProperties.Name="源目录树">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:SourceTreeNode" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Kind}" Opacity="0.65" /></StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <SelectableTextBlock Text="{Binding Issues}" TextWrapping="Wrap" />
                        <TextBlock Text="只浏览已保存的源目录，未应用过滤规则。归档箱配置与备份预览尚未接入；显示的文件不表示会被备份。" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="存储迁移维护" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="当前 Current 根" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding CurrentRootDisplay}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding NewCurrentRoot}" PlaceholderText="新的 Current 根；留空表示不迁移" AutomationProperties.Name="新的 Current 根" />
                    <TextBlock Text="当前 History 根" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding HistoryRootDisplay}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding NewHistoryRoot}" PlaceholderText="新的 History 根；留空表示不迁移" AutomationProperties.Name="新的 History 根" />
                    <TextBlock Text="目标根目录必须事先创建。预览不会创建目录或归档临时文件。" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="检查迁移目标" Command="{Binding PreviewCommand}" />
                    <Button Content="取消操作" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
                <TextBlock Text="新迁移的启动入口尚未开放；已有事务可在下方显式恢复。" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="3  已有迁移事务" FontSize="18" FontWeight="SemiBold" />
                    <Button Content="读取迁移事务" Command="{Binding ReadJournalCommand}" />
                    <SelectableTextBlock Text="{Binding JournalDetails}" TextWrapping="Wrap" />
                    <CheckBox IsChecked="{Binding ConfirmResume}" IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="我确认继续上述事务：复制并提交后会清理清单中的旧副本。取消不会回滚已提交的迁移。" TextWrapping="Wrap" />
                    </CheckBox>
                    <Button Content="继续所选迁移事务" Command="{Binding ResumeCommand}" />
                    <TextBlock Text="仅使用原事务的冻结路径；上方填写的新目标不参与恢复。完成后根目录保护仍保留。" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
